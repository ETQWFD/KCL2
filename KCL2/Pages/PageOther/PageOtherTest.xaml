<local:MyPageRight x:Class="PageOtherTest"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:KCL"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,10">
            <local:MyCard Margin="0,15" Title="自定义下载文件">
                <StackPanel Margin="21,42,21,18">
                    <TextBlock Text="把任意文件的直链填到下面，即可用启动器的多线程引擎下载到指定文件夹。"
                               TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="下载链接" VerticalAlignment="Center" Grid.Column="0" />
                        <local:MyTextBox x:Name="TextDownloadUrl" Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                                         Tag="https://example.com/file.zip" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="保存到" VerticalAlignment="Center" Grid.Column="0" />
                        <local:MyTextBox x:Name="TextDownloadFolder" Grid.Column="1" Height="30" Margin="0,0,10,0"
                                         VerticalContentAlignment="Center" />
                        <local:MyButton x:Name="BtnSelectFolder" Grid.Column="2" Height="32" Text="选择文件夹" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="文件名" VerticalAlignment="Center" Grid.Column="0" />
                        <local:MyTextBox x:Name="TextDownloadName" Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                                         Tag="留空则自动使用链接中的文件名" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Right">
                        <local:MyButton x:Name="BtnDownloadOpen" Width="110" Height="34" Text="打开文件夹" Margin="0,0,12,0" />
                        <local:MyButton x:Name="BtnDownloadStart" Width="110" Height="34" Text="开始下载" ColorType="Highlight" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
